# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================

# Bot Token (получить от @BotFather)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_BOT_TOKEN=your_bot_token_here  # Alias

# Channel ID (публичный канал)
CHAT_ID=@your_channel_username
TELEGRAM_CHANNEL_ID=@your_channel_username  # Alias

# Admin Chat ID (для алертов и уведомлений)
# Формат: числовой ID (например -1001234567890)
# Получить: отправьте боту /start и проверьте логи
ADMIN_CHAT_ID=your_admin_chat_id_here

# =============================================================================
# WHALE MONITOR - BASIC SETTINGS
# =============================================================================

# Режим работы:
# '*' = Discovery Mode (автопоиск топ-200 токенов)
# 'BTC,ETH,SOL' = Allowlist Mode (только указанные активы)
ASSETS=*

# Базовые пороги
MIN_USD=500000                    # Базовый порог в USD
MIN_USD_FLOOR=50000               # Минимальный порог
MIN_USD_K=0.02                    # Коэффициент для динамического порога
MIN_USD_PCTL=75                   # Процентиль для порога

# Временные параметры
POLL_SECONDS=180                  # Интервал опроса blockchain (секунды)
START_FROM_MINUTES_AGO=90         # Начать с N минут назад

# Discovery параметры
DISCOVERY_TOP_N_PER_CHAIN=200     # Топ N токенов на каждой сети
DISCOVERY_REFRESH_HOURS=12        # Обновление watchlist каждые N часов
MIN_TOKEN_AGE_DAYS=7              # Минимальный возраст токена (дни)

# Лимиты публикаций
POSTS_PER_HOUR_CAP=6              # Максимум постов в час

# Визуализация
ENABLE_IMAGES=1                   # 1 = включить графики, 0 = выключить
CHART_BACKEND=sparkline           # sparkline или matplotlib
CHART_THEME=dark                  # dark или light

# =============================================================================
# SMART MONEY DISCOVERY v3.0 (Автопоиск успешных трейдеров)
# =============================================================================

SMART_DISCOVERY_ENABLED=1                      # 1 = включить, 0 = выключить
SMART_DISCOVERY_INTERVAL_HOURS=6               # Запуск каждые N часов
SMART_DISCOVERY_MIN_PRICE_CHANGE=3.0           # Минимальный рост токена (x раз)
SMART_DISCOVERY_MIN_WALLET_ROI=1.0             # Минимальный ROI кошелька (+100%)
SMART_DISCOVERY_MIN_WIN_RATE=0.60              # Минимальный win rate (60%)
SMART_DISCOVERY_MIN_TRADES=5                   # Минимум сделок
SMART_DISCOVERY_LOOKBACK_DAYS=90               # Период анализа (дни)
SMART_DISCOVERY_MAX_WALLETS_PER_RUN=50         # Макс. кошельков для анализа
SMART_DISCOVERY_MAX_NEW_WALLETS=10             # Макс. новых кошельков за раз

# =============================================================================
# VALIDATION ENGINE v3.0 (Автоочистка базы)
# =============================================================================

VALIDATION_ENABLED=1                           # 1 = включить, 0 = выключить
VALIDATION_INTERVAL_DAYS=7                     # Запуск каждые N дней
VALIDATION_MAX_INACTIVE_DAYS=60                # Макс. неактивность (дни)
VALIDATION_MIN_SCORE_TO_KEEP=30                # Минимальный скор для сохранения
VALIDATION_MIN_ROI_TO_KEEP=-0.20               # Минимальный ROI (-20%)
VALIDATION_CHECK_LAST_TRADE=1                  # Проверять последнюю сделку
VALIDATION_CHECK_PERFORMANCE=1                 # Проверять производительность
VALIDATION_NOTIFY_ON_REMOVAL=1                 # Уведомлять об удалениях
VALIDATION_NOTIFY_THRESHOLD=5                  # Уведомить если удалено >N

# =============================================================================
# PERFORMANCE TRACKING v3.0 (Отслеживание результатов)
# =============================================================================

PERFORMANCE_TRACKING_ENABLED=1                 # 1 = включить, 0 = выключить
PERFORMANCE_CHECK_INTERVALS=1,6,24             # Интервалы проверки (часы)
PERFORMANCE_SUCCESS_THRESHOLD_BULLISH=0.02     # Порог успеха bullish (+2%)
PERFORMANCE_SUCCESS_THRESHOLD_BEARISH=-0.02    # Порог успеха bearish (-2%)
PERFORMANCE_HISTORY_SIZE=200                   # Размер истории сигналов
PERFORMANCE_UPDATE_WALLET_SCORES=1             # Обновлять скоры кошельков
PERFORMANCE_SCORE_ADJUSTMENT=5                 # Изменение скора (±5)

# =============================================================================
# ADAPTIVE THRESHOLDS v3.0 (Динамические пороги)
# =============================================================================

ADAPTIVE_THRESHOLDS_ENABLED=1                  # 1 = включить, 0 = выключить

# Базовые пороги
ADAPTIVE_BASE_MIN_CONFIDENCE=30                # Базовый confidence (0-100)
ADAPTIVE_BASE_MIN_SIZE_REL=0.10                # Базовый size_rel (0.1% от volume)
ADAPTIVE_BASE_MIN_VOLUME_24H=1000000           # Базовый volume ($1M)

# Режимы рынка
ADAPTIVE_BULL_THRESHOLD=10.0                   # BTC +10% за 7д = bull
ADAPTIVE_BEAR_THRESHOLD=-10.0                  # BTC -10% за 7д = bear

# Модификаторы для bull market
ADAPTIVE_BULL_CONFIDENCE_MODIFIER=+10          # Повысить confidence на N
ADAPTIVE_BULL_SIZE_REL_MODIFIER=+0.05          # Повысить size_rel
ADAPTIVE_BULL_VOLUME_MODIFIER=1.5              # Умножить volume порог

# Модификаторы для bear market
ADAPTIVE_BEAR_CONFIDENCE_MODIFIER=-5           # Понизить confidence на N
ADAPTIVE_BEAR_SIZE_REL_MODIFIER=-0.03          # Понизить size_rel
ADAPTIVE_BEAR_VOLUME_MODIFIER=0.7              # Умножить volume порог

# Адаптация на основе производительности
ADAPTIVE_LOW_ACCURACY_THRESHOLD=0.60           # Низкая точность (<60%)
ADAPTIVE_HIGH_ACCURACY_THRESHOLD=0.80          # Высокая точность (>80%)
ADAPTIVE_ACCURACY_ADJUSTMENT=10                # Корректировка confidence (±10)
ADAPTIVE_MARKET_REGIME_UPDATE_HOURS=4          # Обновление режима каждые N ч
ADAPTIVE_MIN_SIGNALS_FOR_ADAPTATION=20         # Мин. сигналов для адаптации

# =============================================================================
# LEARNING SYSTEM v3.0 (Система обучения)
# =============================================================================

LEARNING_SYSTEM_ENABLED=1                      # 1 = включить, 0 = выключить
LEARNING_ENABLE_WALLET_SCORING=1               # Обучение скоринга кошельков
LEARNING_ENABLE_SIGNAL_TYPE_WEIGHTS=1          # Обучение весов типов сигналов
LEARNING_ENABLE_PATTERN_DETECTION=1            # Обучение паттернов
LEARNING_RATE=0.1                              # Скорость обучения
LEARNING_MIN_SAMPLES=50                        # Минимум данных
LEARNING_WINDOW_DAYS=30                        # Окно обучения (дни)

# Начальные веса типов сигналов
LEARNING_WEIGHT_SMART_MONEY=0.40               # Smart money (40%)
LEARNING_WEIGHT_MINING=0.30                    # Mining (30%)
LEARNING_WEIGHT_ONCHAIN=0.20                   # Onchain (20%)
LEARNING_WEIGHT_SOCIAL=0.10                    # Social (10%)

LEARNING_MAX_WEIGHT_ADJUSTMENT=0.15            # Макс. корректировка весов
LEARNING_WEIGHT_UPDATE_INTERVAL_DAYS=7         # Обновление весов каждые N дней

# =============================================================================
# WALLET DATABASE v3.0
# =============================================================================

WALLET_DB_TYPE=json                            # json или sqlite
WALLET_INITIAL_SCORE=50                        # Начальный скор (0-100)
WALLET_MAX_SCORE=100                           # Максимальный скор
WALLET_MIN_SCORE=0                             # Минимальный скор
WALLET_SCORE_UPDATE_ON_SUCCESS=+5              # Изменение при успехе
WALLET_SCORE_UPDATE_ON_FAILURE=-3              # Изменение при провале
WALLET_SCORE_DECAY_PER_DAY=0.1                 # Деградация в день
WALLET_MAX_TRACKED=500                         # Максимум кошельков
WALLET_AUTO_PRUNE=1                            # Автоудаление при лимите

# =============================================================================
# ALERTS & NOTIFICATIONS
# =============================================================================

ENABLE_ALERTS=1                                # 1 = включить алерты
ALERT_COOLDOWN_SECONDS=300                     # Cooldown между алертами (сек)
SEND_STARTUP_NOTIFICATION=1                    # Уведомление при запуске
SEND_DAILY_STATS=1                             # Ежедневная статистика

# =============================================================================
# HEALTH CHECK & MONITORING
# =============================================================================

HEALTH_CHECK_ENABLED=1                         # Health check системы
HEALTH_CHECK_INTERVAL=300                      # Интервал проверки (сек)
HEALTH_CHECK_MAX_SILENCE=600                   # Макс. тишина (сек)

# =============================================================================
# API KEYS - BLOCKCHAIN EXPLORERS
# =============================================================================

# Etherscan (ОБЯЗАТЕЛЬНО для Ethereum)
# Получить: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Helius (ОБЯЗАТЕЛЬНО для Solana)
# Получить: https://www.helius.dev/
HELIUS_API_KEY=your_helius_api_key_here

# TronScan (ОБЯЗАТЕЛЬНО для TRON)
# Получить: https://tronscan.org/#/
TRONSCAN_API_KEY=your_tronscan_api_key_here

# Alchemy (опционально, альтернатива Etherscan)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# =============================================================================
# API KEYS - MARKET DATA
# =============================================================================

# CoinGecko (рекомендуется для стабильной работы)
# Получить: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your_coingecko_api_key_here

# CoinMarketCap (опционально)
COINMARKETCAP_API_KEY=your_cmc_api_key_here

# =============================================================================
# API KEYS - NEWS & AI
# =============================================================================

# CryptoPanic (для новостей)
# Получить: https://cryptopanic.com/developers/api/
CRYPTOPANIC_KEY=your_cryptopanic_key_here

# NewsAPI (для новостей)
# Получить: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Gemini AI (РЕКОМЕНДУЕТСЯ для анализа новостей)
# Получить: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (опционально, альтернатива Gemini)
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================

LOG_LEVEL=INFO                                 # DEBUG, INFO, WARNING, ERROR
DEBUG_FILTERS=1                                # Подробные логи фильтров

# =============================================================================
# ADVANCED SETTINGS (обычно не требуют изменения)
# =============================================================================

# Rate Limiting
RATE_LIMIT_ENABLED=1
RATE_LIMIT_CALLS=5
RATE_LIMIT_PERIOD=60

# Retry настройки
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2
RETRY_TIMEOUT=30

# Discovery blacklist (токены для игнорирования)
DISCOVERY_BLACKLIST=SCAM,TEST,FAKE

# Exchange preference для графиков
EXCHANGE_PREFERENCE=binance,okx,bybit,coinbase